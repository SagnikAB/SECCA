{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/analyze.py": {
      "maxDuration": 10,
      "excludeFiles": "{node_modules/**,.venv/**,.vercel/**,dist/**,src/**,tests/**,app.py,main.py,render_server.py,render.yaml,index.html,vite.config.js,package.json,package-lock.json,requirements.txt,pyproject.toml,*.md,.git/**,**/__pycache__/**,api/dev_server.py}"
    }
  }
}
